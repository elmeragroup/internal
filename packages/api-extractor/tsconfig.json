{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@elmeragroup/typescript-config/internal-package.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "stripInternal": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": false,
    "paths": {
      "@fixture/source.js": ["./test/fixtures/module-resolution-alias/source.d.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"],
  "exclude": ["test/fixtures/module-imports-only/**"]
}
