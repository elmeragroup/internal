{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"rootDir": "../..",
		"strict": true,
		"target": "ES2022",
		"noEmit": true,
		"skipLibCheck": false
	},
	"include": [
		"react-component-function-declaration/input.tsx",
		"react-component-function-overloads/input.ts",
		"react-component-function-variable/input.tsx",
		"react-component-generic-function-overloads/input.ts",
		"react-component-return-types/input.tsx",
		"react-hook-multiple-parameters/input.ts",
		"react-hook-overload-signatures/input.ts",
		"react-props-callback-types/input.tsx",
		"react-props-literal-types/input.tsx",
		"react-props-optional-types/input.tsx"
	]
}
