{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Library",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "target": "es2022",
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": true,
    "declarationMap": true
  }
}
