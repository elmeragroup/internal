{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["GITHUB_REPOSITORY"],
  "tasks": {
    "//#lint:oxlint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/oxlint-plugin/**",
        "packages/oxlint-anti-slop/**",
        "packages/oxlint-test-rules/**"
      ],
      "dependsOn": ["@elmeragroup/internal#build"]
    },
    // The Effect lint pass: type-aware over the whole workspace and every declaration it imports, so no input list
    // can name what it reads, and a cached run would replay green. It reads the built declarations of the workspace
    // packages, as the main pass does.
    "//#lint:effect": {
      "cache": false,
      "dependsOn": ["@elmeragroup/internal#build"]
    },
    "//#test:repo-policy": {
      "dependsOn": ["@elmeragroup/release#build"],
      "inputs": [
        "test/**",
        ".oxlintrc.json",
        ".oxlintrc.effect.json",
        // test/effect-lint-config.test.ts walks every committed tsconfig's extends chain to the preset.
        "tsconfig*.json",
        "packages/**/tsconfig*.json",
        "tooling/typescript/**",
        "packages/api-extractor/**",
        "packages/release/**",
        "scripts/**",
        ".changeset/config.json",
        "packages/api-artifacts/package.json",
        "packages/internal/package.json",
        ".github/workflows/merge.yml",
        ".github/workflows/publish-release.yml",
        ".github/workflows/version-packages.yml",
        "package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-package.ts"]
    },
    // `turbo run lint` runs the two workspace passes, after the builds whose declarations they read, whether or not a
    // package has a lint script of its own, plus each package's own lint. `pnpm lint` runs only the two passes
    // (`turbo run //#lint:oxlint //#lint:effect`), since the extractor's own lint repeats the stock pass for its files.
    // The root `lint` script is not a turbo task, so it never runs itself.
    "lint": {
      "dependsOn": ["//#lint:oxlint", "//#lint:effect"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/oxlint-plugin/**",
        "packages/oxlint-anti-slop/**",
        "packages/oxlint-test-rules/**"
      ]
    },
    "type-check": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@elmeragroup/api-extractor#ci:checks": {
      "dependsOn": ["build", "test", "type-check"]
    },
    "ci:checks": {
      "dependsOn": [
        "//#lint:oxlint",
        "//#lint:effect",
        "//#test:repo-policy",
        "type-check",
        "test",
        "build",
        "//#type-check:scripts",
        "//#type-check:tests"
      ]
    },
    "//#type-check:scripts": {
      "dependsOn": ["@elmeragroup/release#build"],
      "inputs": ["scripts/**", "packages/release/**", "tooling/typescript/**"]
    },
    "//#type-check:tests": {
      "dependsOn": ["@elmeragroup/release#build"],
      "inputs": ["test/**", "scripts/**", "packages/release/**", "tooling/typescript/**"]
    },
    "@elmeragroup/internal#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.bundle.json",
        "$TURBO_ROOT$/tooling/typescript/**",
        "$TURBO_ROOT$/packages/api-extractor/src/**",
        "$TURBO_ROOT$/packages/api-artifacts/src/**",
        "$TURBO_ROOT$/packages/oxlint-plugin/**",
        "$TURBO_ROOT$/packages/oxlint-anti-slop/**",
        "$TURBO_ROOT$/packages/oxlint-test-rules/**",
        "$TURBO_ROOT$/packages/release/src/**"
      ]
    }
  }
}
