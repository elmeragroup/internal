{
  "name": "elmera-group-internal",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "ci:checks": "oxfmt --check && turbo run ci:checks",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test",
    "test:repo-policy": "vitest run --config test/vitest.config.mjs",
    "type-check": "turbo run type-check",
    "canary:version": "pnpm --filter @elmeragroup/release build && node scripts/canary-version.ts",
    "packages:pack": "pnpm build && node scripts/canary-pack.ts",
    "canary:pack": "pnpm packages:pack",
    "test:packed-consumer": "node scripts/packed-consumer.ts",
    "release:version": "pnpm exec changeset version && pnpm install --lockfile-only",
    "release:run": "pnpm --filter @elmeragroup/release build && node scripts/publish-release.ts",
    "release:check-pr": "pnpm --filter @elmeragroup/release build && node scripts/check-release-pr.ts",
    "type-check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "type-check:tests": "tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@elmeragroup/oxlint-plugin": "workspace:*",
    "@elmeragroup/oxlint-plugin-anti-slop": "workspace:*",
    "@elmeragroup/typescript-config": "workspace:*",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "@elmeragroup/internal": "workspace:*",
    "@elmeragroup/api-extractor": "workspace:*",
    "@elmeragroup/release": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "esbuild": "catalog:"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "pnpm@11.20.0",
  "type": "module"
}
